NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_CLIPS_BUCKET=clips

# Admin analytics dashboard at /admin?key=...
# Pick anything random and long. Without this set, /admin returns "disabled".
ADMIN_KEY=change-me-something-random
# Optional: salt for hashing IPs in event logs (privacy). Defaults if unset.
IP_HASH_SALT=change-me-too
